<%
  variant_links = [
    ['Prototype A', 'split-pill'],
    ['Prototype B', 'glass-tabs'],
    ['Prototype C', 'command-bar']
  ]

  project_options = ['All projects', 'Dashboard', 'Raizia', 'DevOps', 'No project']
  status_options = ['All statuses', 'Queued', 'In progress', 'Ready for review', 'Complete']
%>

<div class="min-h-screen bg-slate-100 text-slate-900 lg:grid lg:grid-cols-[280px_minmax(0,1fr)]">
  <%= render "layouts/sidebar", updated_at: @updated_at %>

  <main class="bg-gradient-to-br from-slate-100 via-white to-slate-200/80 px-4 py-6 sm:px-6 lg:px-10 lg:py-8">
    <div class="flex flex-col gap-4 border-b border-slate-200/80 pb-6 xl:flex-row xl:items-end xl:justify-between">
      <div>
        <p class="text-sm font-medium text-sky-700"><%= @meta[:eyebrow] %></p>
        <h2 class="mt-1 text-3xl font-semibold tracking-[-0.04em] text-slate-950"><%= @meta[:name] %></h2>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600"><%= @meta[:description] %></p>
      </div>

      <div class="flex flex-wrap gap-2">
        <% variant_links.each do |label, key| %>
          <% active = key == @variant %>
          <%= link_to label, kanban_filter_prototype_path(key), class: "inline-flex items-center justify-center rounded-2xl px-4 py-2.5 text-sm font-semibold transition #{active ? 'bg-slate-950 text-white shadow-lg shadow-slate-900/10' : 'border border-slate-300 bg-white text-slate-700 hover:border-slate-400 hover:bg-slate-50'}" %>
        <% end %>
      </div>
    </div>

    <% if @variant == 'split-pill' %>
      <section class="mt-6 overflow-hidden rounded-[2rem] border border-slate-200/70 bg-white shadow-[0_24px_80px_-42px_rgba(15,23,42,0.45)]">
        <div class="border-b border-slate-100 px-5 py-4 sm:px-6">
          <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
            <div class="flex flex-wrap gap-2">
              <% status_options.each_with_index do |label, index| %>
                <span class="inline-flex items-center rounded-full px-4 py-2 text-sm font-semibold <%= index.zero? ? 'bg-slate-950 text-white shadow-lg shadow-slate-900/10' : 'bg-slate-100 text-slate-600' %>"><%= label %></span>
              <% end %>
            </div>
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex items-center gap-2 rounded-full border border-sky-200 bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-800">
                <span class="inline-flex h-2.5 w-2.5 rounded-full bg-sky-500"></span>
                Project · Dashboard
              </span>
              <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600">Reset</span>
              <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600">Archive</span>
            </div>
          </div>
        </div>

        <div class="grid gap-4 px-5 py-5 sm:px-6 xl:grid-cols-3">
          <div class="rounded-[1.6rem] border border-slate-200 bg-slate-50 p-5">
            <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Why it feels better</div>
            <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-600">
              <li>• Fast visual scan — status chips read like tabs.</li>
              <li>• Project filter gets a single highlighted pill instead of a heavy form field.</li>
              <li>• Actions stay lightweight and out of the way.</li>
            </ul>
          </div>
          <div class="rounded-[1.6rem] border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-700">Filter anatomy</div>
            <div class="mt-4 space-y-3 text-sm text-slate-600">
              <div class="flex items-center justify-between rounded-2xl bg-slate-100 px-4 py-3"><span>Primary scope</span><span class="font-semibold text-slate-900">Status pills</span></div>
              <div class="flex items-center justify-between rounded-2xl bg-sky-50 px-4 py-3"><span>Secondary scope</span><span class="font-semibold text-sky-800">Project pill</span></div>
              <div class="flex items-center justify-between rounded-2xl bg-slate-100 px-4 py-3"><span>Utility</span><span class="font-semibold text-slate-900">Reset + archive</span></div>
            </div>
          </div>
          <div class="rounded-[1.6rem] border border-dashed border-slate-300 bg-white/70 p-5">
            <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Best for</div>
            <p class="mt-4 text-sm leading-6 text-slate-600">A cleaner Kanban header that still feels friendly and lightweight on desktop.</p>
          </div>
        </div>
      </section>
    <% elsif @variant == 'glass-tabs' %>
      <section class="mt-6 overflow-hidden rounded-[2rem] border border-white/50 bg-gradient-to-r from-slate-900 via-slate-800 to-sky-950 p-[1px] shadow-[0_28px_90px_-45px_rgba(15,23,42,0.8)]">
        <div class="rounded-[1.95rem] bg-white/75 px-4 py-4 backdrop-blur-xl sm:px-6 sm:py-5">
          <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
            <div class="flex flex-wrap gap-2">
              <% ['Overview', 'All cards', 'Assigned to me', 'Needs review'].each_with_index do |label, index| %>
                <span class="inline-flex items-center rounded-2xl px-4 py-2.5 text-sm font-semibold <%= index == 1 ? 'bg-white text-slate-950 shadow-lg shadow-slate-900/10 ring-1 ring-white' : 'bg-white/30 text-slate-700 ring-1 ring-white/40' %>"><%= label %></span>
              <% end %>
            </div>
            <div class="grid gap-3 md:grid-cols-[minmax(0,1.2fr)_minmax(0,0.9fr)_auto]">
              <div class="flex items-center gap-3 rounded-[1.4rem] border border-white/50 bg-white/60 px-4 py-3 text-sm text-slate-500 shadow-inner shadow-white/40">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-slate-950 text-white">⌕</span>
                <span>Search cards, workers, tags…</span>
              </div>
              <div class="flex items-center justify-between rounded-[1.4rem] border border-sky-200 bg-sky-50/90 px-4 py-3 text-sm font-semibold text-slate-900">
                <span>Project</span>
                <span class="text-sky-800">Dashboard ▾</span>
              </div>
              <div class="flex gap-2">
                <span class="inline-flex items-center rounded-[1.2rem] bg-slate-950 px-4 py-3 text-sm font-semibold text-white">Apply</span>
                <span class="inline-flex items-center rounded-[1.2rem] border border-white/70 bg-white/70 px-4 py-3 text-sm font-semibold text-slate-700">Reset</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-6 grid gap-4 xl:grid-cols-3">
        <div class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm">
          <div class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-700">Why it feels better</div>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-600">
            <li>• Looks more polished and premium without becoming flashy.</li>
            <li>• Search, tabs, and project select each get a clear role.</li>
            <li>• Works well if the board later gets more filters.</li>
          </ul>
        </div>
        <div class="rounded-[1.75rem] border border-slate-200 bg-slate-950 p-6 text-slate-200 shadow-sm">
          <div class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-300">Visual tone</div>
          <p class="mt-4 text-sm leading-6 text-slate-300">Closer to a control room header: soft glass panel, large touch targets, and stronger hierarchy.</p>
        </div>
        <div class="rounded-[1.75rem] border border-dashed border-slate-300 bg-white/70 p-6">
          <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Best for</div>
          <p class="mt-4 text-sm leading-6 text-slate-600">If Frank wants Dash to feel more productized and a little more high-end.</p>
        </div>
      </section>
    <% else %>
      <section class="mt-6 overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-950 shadow-[0_28px_90px_-45px_rgba(15,23,42,0.9)]">
        <div class="border-b border-white/10 px-5 py-4 sm:px-6">
          <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center rounded-2xl bg-white px-4 py-2.5 text-sm font-semibold text-slate-950">Project: Dashboard ▾</span>
              <span class="inline-flex items-center rounded-2xl bg-white/10 px-4 py-2.5 text-sm font-medium text-slate-200 ring-1 ring-white/10">Lane: All ▾</span>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <% ['Queued', 'In progress', 'Review', 'Done'].each_with_index do |label, index| %>
                <span class="inline-flex items-center rounded-full px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] <%= index == 1 ? 'bg-sky-400 text-slate-950' : 'bg-white/10 text-slate-300' %>"><%= label %></span>
              <% end %>
            </div>
          </div>
        </div>

        <div class="grid gap-4 px-5 py-5 sm:px-6 xl:grid-cols-[minmax(0,1.4fr)_minmax(0,0.9fr)]">
          <div class="rounded-[1.6rem] border border-white/10 bg-white/5 p-5 text-slate-200">
            <div class="flex items-center justify-between gap-3">
              <div>
                <div class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-300">Command bar feel</div>
                <h3 class="mt-2 text-xl font-semibold text-white">Dense, operator-friendly filter strip</h3>
              </div>
              <span class="inline-flex items-center rounded-2xl bg-sky-400 px-4 py-2 text-sm font-semibold text-slate-950">Apply filters</span>
            </div>
            <p class="mt-4 text-sm leading-6 text-slate-300">This version leans into a more serious operations-console vibe and makes multi-filter expansion easy later.</p>
          </div>
          <div class="grid gap-3">
            <div class="rounded-[1.35rem] bg-white px-4 py-4 text-sm text-slate-600">
              <div class="font-semibold text-slate-950">Why it feels better</div>
              <div class="mt-2">More intentional than the current stacked form and better aligned with the darker Dash shell.</div>
            </div>
            <div class="rounded-[1.35rem] bg-white/10 px-4 py-4 text-sm text-slate-300 ring-1 ring-white/10">
              <div class="font-semibold text-white">Best for</div>
              <div class="mt-2">If Frank wants the Kanban page to feel more like an internal ops tool than a standard CRUD form.</div>
            </div>
          </div>
        </div>
      </section>
    <% end %>

    <section class="mt-8 grid gap-4 xl:grid-cols-3">
      <% 3.times do |index| %>
        <div class="rounded-[1.75rem] border border-slate-200 bg-white/80 p-5 shadow-sm">
          <div class="flex items-center justify-between gap-3">
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Preview frame <%= index + 1 %></div>
              <div class="mt-1 text-lg font-semibold text-slate-950">Sample board context</div>
            </div>
            <span class="inline-flex min-w-[2.25rem] items-center justify-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700"><%= [12, 7, 3][index] %></span>
          </div>
          <div class="mt-4 space-y-3">
            <% [['Fix API routes', 'Dashboard'], ['Polish overview stats', 'Dashboard'], ['Backfill project names', 'DevOps']].each do |title, project| %>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
                <div class="text-sm font-semibold text-slate-900"><%= title %></div>
                <div class="mt-1 text-xs font-medium uppercase tracking-[0.18em] text-slate-500"><%= project %></div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>
  </main>
</div>
