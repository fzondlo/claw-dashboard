<div class="min-h-screen bg-slate-100 text-slate-900 lg:grid lg:grid-cols-[280px_minmax(0,1fr)]">
  <%= render "layouts/sidebar", updated_at: @updated_at %>

  <main class="bg-gradient-to-br from-slate-100 via-white to-slate-200/80 px-4 py-6 sm:px-6 lg:px-10 lg:py-8">
    <div class="flex flex-col gap-4 border-b border-slate-200/80 pb-6 xl:flex-row xl:items-end xl:justify-between">
      <div>
        <p class="text-sm font-medium text-sky-700">Worker activity</p>
        <h2 class="mt-1 text-3xl font-semibold tracking-[-0.04em] text-slate-950">Kanban board</h2>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Prototype A is now the live board. Filters, live heartbeat lanes, review links, archive actions, and review-modal flow stay intact.</p>
      </div>

      <div class="flex flex-wrap gap-2">
        <%= link_to 'Archived tasks', archive_path, class: 'inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-50' %>
        <button type="button" class="js-open-create-task-modal inline-flex items-center justify-center gap-2 rounded-2xl border border-violet-600 bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:border-violet-700 hover:bg-violet-700">
          <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-violet-700/70">
            <svg viewBox="0 0 20 20" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
              <path d="M10 4.25v11.5M4.25 10h11.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </span>
          <span>Create task</span>
        </button>
      </div>
    </div>

    <%= render 'live_sections' %>

  </main>
</div>

<div id="kanban-card-modal" class="fixed inset-0 z-50 hidden" aria-hidden="true">
  <div class="js-card-modal-backdrop absolute inset-0 bg-slate-950/60 backdrop-blur-sm"></div>
  <div class="relative flex min-h-full items-end justify-center p-2 sm:items-center sm:p-6">
    <div class="flex max-h-[calc(100vh-1rem)] w-full max-w-5xl flex-col overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_40px_120px_-30px_rgba(15,23,42,0.55)] sm:max-h-[calc(100vh-3rem)]">
      <div class="flex items-start justify-between gap-4 border-b border-slate-100 px-6 py-5 sm:px-7 sm:py-6">
        <div>
          <div id="kanban-card-modal-id" class="text-[11px] font-black uppercase tracking-[0.32em] text-sky-600"></div>
          <h3 id="kanban-card-modal-title" class="mt-2 text-2xl font-semibold leading-tight tracking-[-0.03em] text-slate-950 sm:text-[1.75rem]"></h3>
        </div>
        <button type="button" class="js-close-card-modal inline-flex h-10 w-10 flex-none items-center justify-center rounded-full bg-slate-100 text-xl text-slate-400 transition hover:bg-slate-200 hover:text-slate-700" aria-label="Close card details">×</button>
      </div>

      <div class="min-h-0 flex flex-1 flex-col lg:flex-row lg:divide-x lg:divide-slate-100">
        <div class="min-h-0 flex-1 overflow-y-auto px-5 py-5 sm:px-6 lg:px-6 lg:py-5">
          <div class="space-y-4">
            <div id="kanban-card-modal-live" class="hidden rounded-2xl bg-sky-50 px-4 py-3 text-sm font-medium text-sky-700 ring-1 ring-sky-100">Live worker task</div>

            <section id="kanban-card-modal-completion-duration" class="hidden rounded-2xl border border-emerald-100 bg-emerald-50 px-4 py-4">
              <div class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-700">Completion duration</div>
              <div id="kanban-card-modal-completion-duration-value" class="mt-2 text-lg font-semibold text-emerald-900"></div>
              <p class="mt-1 text-sm leading-6 text-emerald-800/80">Measured from In progress to Ready for review.</p>
            </section>

            <section class="rounded-2xl border border-slate-100 bg-slate-50 px-4 py-4">
              <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Description</div>
              <div id="kanban-card-modal-description" class="markdown-body mt-2 text-sm leading-6 text-slate-700"></div>
            </section>

            <section class="rounded-2xl border border-slate-100 bg-slate-50 px-4 py-4">
              <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Activity</div>
              <div id="kanban-card-modal-activity" class="mt-2 text-sm leading-6 text-slate-700"></div>
              <div id="kanban-card-modal-activity-feedback" class="mt-4 hidden rounded-2xl border border-violet-200 bg-white p-4 shadow-sm shadow-violet-100/70">
                <div class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-700">Add QA feedback</div>
                <p class="mt-1 text-sm font-medium text-slate-700">Add a new activity update, then requeue the task so the worker follows the latest feedback.</p>
                <div class="mt-3 space-y-3">
                  <textarea id="kanban-card-modal-feedback" rows="4" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700 outline-none transition focus:border-violet-300 focus:bg-white focus:ring-2 focus:ring-violet-100" placeholder="Describe what needs to change before this can pass QA."></textarea>
                  <button type="button" id="kanban-card-modal-submit-feedback-requeue" class="inline-flex w-full items-center justify-center rounded-2xl border border-violet-300 bg-violet-600 px-4 py-3 text-sm font-semibold text-white shadow-sm shadow-violet-600/20 transition hover:bg-violet-700 disabled:cursor-not-allowed disabled:border-violet-200 disabled:bg-violet-200">Submit and requeue</button>
                </div>
              </div>
            </section>

            <section class="rounded-2xl border border-slate-100 bg-slate-50 px-4 py-4">
              <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Review focus</div>
              <div id="kanban-card-modal-review-focus" class="markdown-body mt-2 text-sm leading-6 text-slate-700"></div>
            </section>
          </div>
        </div>

        <aside class="flex w-full flex-none flex-col gap-4 border-t border-slate-100 bg-slate-50 px-5 py-5 sm:px-6 lg:w-80 lg:border-t-0 lg:px-5">
          <div>
            <div class="text-[11px] font-black uppercase tracking-[0.28em] text-amber-700">Action rail</div>
            <p class="mt-1.5 text-xs leading-5 text-slate-500">Review targets, completion, and requeue actions stay pinned here.</p>
          </div>

          <section id="kanban-card-modal-review-links" class="hidden rounded-2xl border border-sky-200 bg-white p-4 shadow-sm shadow-sky-100/70">
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-700">Review</div>
            <p class="mt-1 text-sm font-medium text-slate-700">Open the latest review target for this task.</p>
            <div id="kanban-card-modal-review-links-list" class="mt-3 flex flex-col gap-2"></div>
          </section>

          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Status</div>
            <div class="mt-3 flex flex-wrap gap-2" id="kanban-card-modal-badges"></div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <div class="flex flex-col gap-2">
              <button type="button" id="kanban-card-modal-mark-complete" class="inline-flex w-full items-center justify-center rounded-2xl border border-emerald-400 bg-emerald-600 px-4 py-3 text-sm font-semibold text-white shadow-sm shadow-emerald-600/20 transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:border-emerald-200 disabled:bg-emerald-200">Mark complete</button>
              <div class="grid grid-cols-2 gap-2">
                <button type="button" id="kanban-card-modal-prev" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50">← Prev</button>
                <button type="button" id="kanban-card-modal-next" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50">Next →</button>
              </div>
            </div>
          </div>

          <section id="kanban-card-modal-requeue-actions" class="hidden rounded-2xl border border-violet-200 bg-white p-4 shadow-sm shadow-violet-100/70">
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-700">Requeue options</div>
            <p class="mt-1 text-sm font-medium text-slate-700">Use the activity section to add feedback, or send the task back unchanged.</p>
            <div class="mt-3 flex flex-col gap-2">
              <button type="button" id="kanban-card-modal-requeue-original" class="js-requeue-card inline-flex w-full items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:border-slate-200 disabled:bg-slate-100 disabled:text-slate-400">Requeue with original instructions</button>
            </div>
          </section>
        </aside>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const modal = document.getElementById('kanban-card-modal');
    if (!modal) return;

    const createTaskModal = () => document.getElementById('kanban-create-task-modal');
    const createTaskModalPanel = () => createTaskModal()?.querySelector('.js-create-task-modal-panel');
    const openCreateTaskModal = () => {
      const modal = createTaskModal();
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('overflow-hidden');
      window.setTimeout(() => modal.querySelector('input, textarea, select')?.focus(), 0);
    };
    const closeCreateTaskModal = () => {
      const modal = createTaskModal();
      if (!modal) return;
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
      if (document.getElementById('kanban-card-modal')?.classList.contains('hidden')) {
        document.body.classList.remove('overflow-hidden');
      }
    };

    const fields = {
      id: document.getElementById('kanban-card-modal-id'),
      title: document.getElementById('kanban-card-modal-title'),
      badges: document.getElementById('kanban-card-modal-badges'),
      description: document.getElementById('kanban-card-modal-description'),
      activity: document.getElementById('kanban-card-modal-activity'),
      reviewFocus: document.getElementById('kanban-card-modal-review-focus'),
      reviewLinks: document.getElementById('kanban-card-modal-review-links'),
      reviewLinksList: document.getElementById('kanban-card-modal-review-links-list'),
      requeueActions: document.getElementById('kanban-card-modal-requeue-actions'),
      submitFeedbackRequeue: document.getElementById('kanban-card-modal-submit-feedback-requeue'),
      feedback: document.getElementById('kanban-card-modal-feedback'),
      activityFeedback: document.getElementById('kanban-card-modal-activity-feedback'),
      requeueOriginal: document.getElementById('kanban-card-modal-requeue-original'),
      live: document.getElementById('kanban-card-modal-live'),
      completionDuration: document.getElementById('kanban-card-modal-completion-duration'),
      completionDurationValue: document.getElementById('kanban-card-modal-completion-duration-value'),
      prev: document.getElementById('kanban-card-modal-prev'),
      next: document.getElementById('kanban-card-modal-next'),
      markComplete: document.getElementById('kanban-card-modal-mark-complete')
    };

    const fallbackText = '—';
    const liveSectionsEndpoint = '<%= live_kanban_board_path(project_id: @selected_project) %>';
    const liveSectionsContainer = () => document.getElementById('kanban-live-sections');
    const pollIntervalMs = 15000;
    const columnSortStorageKey = 'kanbanColumnSortPreferences';
    let isRefreshingBoard = false;
    let activeCardId = null;

    const liveSectionsUrl = () => {
      const url = new URL(liveSectionsEndpoint, window.location.origin);
      url.searchParams.set('_ts', String(Date.now()));
      return url.toString();
    };

    const escapeHtml = (value) => {
      const div = document.createElement('div');
      div.textContent = value || '';
      return div.innerHTML;
    };

    const badgeMarkup = (text, classes = 'border-slate-200 bg-slate-100 text-slate-700') => (
      `<span class="inline-flex rounded-full border px-3 py-1 text-xs font-semibold ${classes}">${escapeHtml(text)}</span>`
    );

    const reviewLinkMarkup = (url, primary = false) => {
      const safeUrl = escapeHtml(url);
      const classes = primary
        ? 'border-sky-300 bg-sky-600 text-white hover:bg-sky-700 hover:border-sky-700'
        : 'border-sky-200 bg-white text-sky-700 hover:bg-sky-50';

      return `<a href="${safeUrl}" target="_blank" rel="noopener" class="inline-flex items-center justify-center rounded-xl border px-4 py-2.5 text-sm font-semibold transition ${classes}">Review link ↗</a>`;
    };

    const loadColumnSortPreferences = () => {
      try {
        return JSON.parse(window.localStorage.getItem(columnSortStorageKey) || '{}');
      } catch (error) {
        console.warn('Could not load kanban column sort preferences.', error);
        return {};
      }
    };

    const saveColumnSortPreferences = (preferences) => {
      try {
        window.localStorage.setItem(columnSortStorageKey, JSON.stringify(preferences));
      } catch (error) {
        console.warn('Could not save kanban column sort preferences.', error);
      }
    };

    const columnSortPreferenceFor = (column) => {
      const preferences = loadColumnSortPreferences();
      const key = column?.dataset?.kanbanColumn;
      const fallback = column?.dataset?.sortDefault || 'oldest';
      return (key && preferences[key]) || fallback;
    };

    const cardSortTimestamp = (card) => {
      const rawValue = card?.dataset?.cardSortTimestamp;
      const parsed = rawValue ? Date.parse(rawValue) : NaN;
      return Number.isNaN(parsed) ? 0 : parsed;
    };

    const updateColumnSortButton = (column, direction) => {
      const button = column.querySelector('.js-kanban-column-sort');
      if (!button) return;

      const icon = button.querySelector('.js-kanban-column-sort-icon');
      const isNewest = direction === 'newest';
      const stateLabel = isNewest ? 'Sorted newest first — click to switch to oldest first' : 'Sorted oldest first — click to switch to newest first';

      button.dataset.sortDirection = direction;
      button.setAttribute('aria-pressed', String(isNewest));
      button.setAttribute('title', stateLabel);
      button.setAttribute('aria-label', stateLabel);
      button.classList.toggle('border-sky-300', isNewest);
      button.classList.toggle('bg-sky-50', isNewest);
      button.classList.toggle('text-sky-700', isNewest);
      button.classList.toggle('shadow-sm', isNewest);
      button.classList.toggle('border-slate-200', !isNewest);
      button.classList.toggle('bg-white', !isNewest);
      button.classList.toggle('text-slate-600', !isNewest);
      button.classList.toggle('shadow-sm', !isNewest);

      if (icon) {
        icon.textContent = isNewest ? '↓' : '↑';
        icon.classList.toggle('scale-110', isNewest);
      }
    };

    const applyColumnSort = (column, direction = columnSortPreferenceFor(column)) => {
      if (!column) return;

      const cardsContainer = column.querySelector('[data-kanban-column-cards]');
      if (!cardsContainer) return;

      const cards = Array.from(cardsContainer.querySelectorAll('[data-card-sort-timestamp]'));
      cards.sort((left, right) => {
        const difference = cardSortTimestamp(left) - cardSortTimestamp(right);
        return direction === 'newest' ? -difference : difference;
      });
      cards.forEach((card) => cardsContainer.appendChild(card));
      updateColumnSortButton(column, direction);
    };

    const applyAllColumnSorts = () => {
      document.querySelectorAll('[data-kanban-column]').forEach((column) => applyColumnSort(column));
    };

    const toggleColumnSort = (button) => {
      const column = button.closest('[data-kanban-column]');
      if (!column) return;

      const key = column.dataset.kanbanColumn;
      const current = columnSortPreferenceFor(column);
      const next = current === 'newest' ? 'oldest' : 'newest';
      const preferences = loadColumnSortPreferences();
      preferences[key] = next;
      saveColumnSortPreferences(preferences);
      applyColumnSort(column, next);
    };

    const modalButtons = () => Array.from(document.querySelectorAll('.js-open-card-modal'));
    const reviewButtons = () => modalButtons().filter((button) => button.dataset.cardStatusKey === 'ready_for_review');
    const findButtonByCardId = (cardId) => modalButtons().find((button) => button.dataset.cardId === String(cardId));
    const findReviewButtonByCardId = (cardId) => reviewButtons().find((button) => button.dataset.cardId === String(cardId));
    const activeCardButton = () => findButtonByCardId(activeCardId);

    const sameStatusButtons = () => {
      const activeButton = activeCardButton();
      const activeStatusKey = activeButton?.dataset?.cardStatusKey;
      if (!activeStatusKey) return [];

      return modalButtons().filter((button) => button.dataset.cardStatusKey === activeStatusKey);
    };

    const adjacentButton = (direction = 1) => {
      const buttons = sameStatusButtons();
      if (!buttons.length || !activeCardId) return null;

      const index = buttons.findIndex((button) => button.dataset.cardId === String(activeCardId));
      if (index === -1) return null;

      return buttons[index + direction] || null;
    };

    const setReviewControls = (data) => {
      const isReviewTask = data.cardStatusKey === 'ready_for_review';
      const hasPrevious = Boolean(adjacentButton(-1));
      const hasNext = Boolean(adjacentButton(1));
      const canRequeue = isReviewTask && Boolean(data.cardId);

      fields.prev.disabled = !hasPrevious;
      fields.next.disabled = !hasNext;
      fields.markComplete.disabled = !isReviewTask || !data.cardId;
      fields.markComplete.dataset.cardId = data.cardId || '';
      fields.requeueActions.classList.toggle('hidden', !canRequeue);
      fields.submitFeedbackRequeue.disabled = !canRequeue;
      fields.requeueOriginal.disabled = !canRequeue;
      fields.submitFeedbackRequeue.dataset.cardId = data.cardId || '';
      fields.requeueOriginal.dataset.cardId = data.cardId || '';
      fields.requeueOriginal.dataset.requeueMode = 'original';
    };

    const openModal = (button) => {
      const data = button.dataset;
      activeCardId = data.cardId || null;
      fields.id.textContent = `Task #${data.cardIdLabel || fallbackText}`;
      fields.title.textContent = data.cardTitle || 'Untitled task';

      const badges = [
        badgeMarkup(data.cardProject || 'No project', 'border-sky-100 bg-sky-50 text-sky-700'),
        badgeMarkup(data.cardStatus || 'Task', data.cardStatusKey === 'ready_for_review' ? 'border-amber-200 bg-amber-100 text-amber-800' : 'border-slate-200 bg-slate-100 text-slate-700')
      ];

      if (data.cardLane) badges.push(badgeMarkup(data.cardLane));
      if (data.cardWorker && data.cardWorker !== data.cardLane) badges.push(badgeMarkup(data.cardWorker));
      if (data.cardTags) badges.push(badgeMarkup(data.cardTags));

      const reviewLinks = (data.cardReviewLinks || '')
        .split('\n')
        .map((url) => url.trim())
        .filter(Boolean);

      fields.badges.innerHTML = badges.join('');
      fields.description.innerHTML = data.cardDescriptionHtml || '<p>—</p>';
      fields.activity.innerHTML = data.cardActivityHtml || '<p>—</p>';
      fields.reviewFocus.innerHTML = data.cardReviewFocusHtml || '<p>—</p>';
      fields.reviewLinks.classList.toggle('hidden', reviewLinks.length === 0);
      fields.reviewLinksList.innerHTML = reviewLinks.map((url, index) => reviewLinkMarkup(url, index === 0)).join('');
      fields.feedback.value = '';
      fields.activityFeedback.classList.toggle('hidden', data.cardStatusKey !== 'ready_for_review');
      fields.live.classList.toggle('hidden', data.cardLive !== 'true');
      const completionDuration = (data.cardCompletionDuration || '').trim();
      fields.completionDuration.classList.toggle('hidden', !completionDuration);
      fields.completionDurationValue.textContent = completionDuration;
      setReviewControls(data);

      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('overflow-hidden');

      // Push deep-link URL so the open card can be shared/bookmarked
      if (activeCardId) {
        const url = new URL(window.location.href);
        url.searchParams.set('card', activeCardId);
        history.pushState({ cardId: activeCardId }, '', url.toString());
      }
    };

    const closeModal = () => {
      activeCardId = null;
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('overflow-hidden');

      // Restore URL — remove the ?card= param
      const url = new URL(window.location.href);
      url.searchParams.delete('card');
      history.pushState({}, '', url.toString());
    };

    const replaceLiveSections = (html) => {
      const currentSections = liveSectionsContainer();
      if (!currentSections) return;

      const template = document.createElement('template');
      template.innerHTML = html.trim();
      const nextSections = template.content.firstElementChild;
      if (!nextSections) return;

      currentSections.replaceWith(nextSections);
      applyAllColumnSorts();
    };

    const refreshBoard = async () => {
      if (isRefreshingBoard || document.hidden) return;

      isRefreshingBoard = true;

      try {
        const response = await fetch(liveSectionsUrl(), {
          headers: {
            'Accept': 'text/html',
            'Cache-Control': 'no-cache'
          },
          cache: 'no-store',
          credentials: 'same-origin'
        });

        if (!response.ok) throw new Error(`Board refresh failed with ${response.status}`);

        const html = await response.text();
        replaceLiveSections(html);
        return true;
      } catch (error) {
        console.error(error);
        return false;
      } finally {
        isRefreshingBoard = false;
      }
    };

    const openAdjacentCard = (direction = 1) => {
      const nextButton = adjacentButton(direction);
      if (!nextButton) return false;
      openModal(nextButton);
      return true;
    };

    const openNextReviewTask = async (currentCardId) => {
      const reviewTaskButtons = reviewButtons();
      const index = reviewTaskButtons.findIndex((button) => button.dataset.cardId === String(currentCardId));
      const fallbackButton = reviewTaskButtons[index + 1] || reviewTaskButtons[0] || null;
      const nextReviewId = fallbackButton?.dataset.cardId;

      await refreshBoard();

      const nextButton = nextReviewId ? findReviewButtonByCardId(nextReviewId) : reviewButtons()[0];
      if (nextButton) {
        openModal(nextButton);
        return true;
      }

      const completedButton = currentCardId ? findButtonByCardId(currentCardId) : null;
      if (completedButton) {
        openModal(completedButton);
        return true;
      }

      closeModal();
      return false;
    };

    window.setInterval(refreshBoard, pollIntervalMs);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) refreshBoard();
    });

    document.addEventListener('click', async (event) => {
      const columnSortButton = event.target.closest('.js-kanban-column-sort');
      if (columnSortButton) {
        event.preventDefault();
        event.stopPropagation();
        toggleColumnSort(columnSortButton);
        return;
      }

      const openCreateTaskButton = event.target.closest('.js-open-create-task-modal');
      if (openCreateTaskButton) {
        event.preventDefault();
        event.stopPropagation();
        openCreateTaskModal();
        return;
      }

      if (event.target.closest('.js-close-create-task-modal')) {
        event.preventDefault();
        event.stopPropagation();
        closeCreateTaskModal();
        return;
      }

      const createTaskModalElement = createTaskModal();
      if (createTaskModalElement && !createTaskModalElement.classList.contains('hidden')) {
        const panel = createTaskModalPanel();
        if (panel && !panel.contains(event.target) && !event.target.closest('.js-open-create-task-modal')) {
          closeCreateTaskModal();
          return;
        }
      }

      const archiveAllButton = event.target.closest('.js-archive-all-complete');
      if (archiveAllButton) {
        event.preventDefault();
        event.stopPropagation();

        const projectId = archiveAllButton.dataset.projectId || '';
        if (!window.confirm('Archive every task in the Complete column?')) return;

        archiveAllButton.disabled = true;

        try {
          const query = projectId ? `?project_id=${encodeURIComponent(projectId)}` : '';
          const response = await fetch(`/kanban/cards/archive_complete${query}`, {
            method: 'DELETE',
            headers: {
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || '',
              'Accept': 'application/json'
            },
            credentials: 'same-origin'
          });

          const payload = await response.json();
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Archive all failed');

          if (!modal.classList.contains('hidden')) closeModal();
          refreshBoard();
        } catch (error) {
          console.error(error);
          alert('Could not archive the completed tasks.');
          archiveAllButton.disabled = false;
        }

        return;
      }

      const submitFeedbackButton = event.target.closest('#kanban-card-modal-submit-feedback-requeue');
      if (submitFeedbackButton) {
        event.preventDefault();
        event.stopPropagation();

        const cardId = submitFeedbackButton.dataset.cardId;
        const feedback = fields.feedback?.value?.trim() || '';
        if (!cardId) return;
        if (!feedback) {
          alert('Add QA feedback before requeuing the task.');
          fields.feedback?.focus();
          return;
        }

        submitFeedbackButton.disabled = true;
        fields.requeueOriginal.disabled = true;

        try {
          const response = await fetch(`/kanban/cards/${cardId}/submit_feedback_and_requeue`, {
            method: 'PATCH',
            headers: {
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || '',
              'Accept': 'application/json',
              'Content-Type': 'application/json'
            },
            credentials: 'same-origin',
            body: JSON.stringify({ feedback })
          });

          const payload = await response.json();
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Submit and requeue failed');

          if (!modal.classList.contains('hidden')) closeModal();
          await refreshBoard();
        } catch (error) {
          console.error(error);
          alert(error.message || 'Could not submit feedback and requeue the task.');
          submitFeedbackButton.disabled = false;
          fields.requeueOriginal.disabled = false;
        }

        return;
      }

      const requeueButton = event.target.closest('.js-requeue-card, #kanban-card-modal-requeue-original');
      if (requeueButton) {
        event.preventDefault();
        event.stopPropagation();

        const cardId = requeueButton.dataset.cardId;
        const requeueMode = requeueButton.dataset.requeueMode === 'original' ? 'original' : 'recommendation';
        const endpoint = requeueMode === 'original' ? 'requeue_with_original_instructions' : 'requeue_with_recommendation';
        const errorMessage = requeueMode === 'original'
          ? 'Could not requeue the task with original instructions.'
          : 'Could not requeue the task with recommendation.';

        if (!cardId) return;

        requeueButton.disabled = true;
        fields.submitFeedbackRequeue.disabled = true;
        fields.requeueOriginal.disabled = true;

        try {
          const response = await fetch(`/kanban/cards/${cardId}/${endpoint}`, {
            method: 'PATCH',
            headers: {
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || '',
              'Accept': 'application/json'
            },
            credentials: 'same-origin'
          });

          const payload = await response.json();
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Requeue failed');

          if (!modal.classList.contains('hidden')) closeModal();
          await refreshBoard();
        } catch (error) {
          console.error(error);
          alert(errorMessage);
          requeueButton.disabled = false;
          fields.submitFeedbackRequeue.disabled = false;
          fields.requeueOriginal.disabled = false;
        }

        return;
      }

      const markCompleteButton = event.target.closest('.js-mark-complete-card, #kanban-card-modal-mark-complete');
      if (markCompleteButton) {
        event.preventDefault();
        event.stopPropagation();

        const cardId = markCompleteButton.dataset.cardId;
        if (!cardId) return;

        markCompleteButton.disabled = true;
        if (fields.markComplete !== markCompleteButton) fields.markComplete.disabled = true;

        try {
          const response = await fetch(`/kanban/cards/${cardId}/complete`, {
            method: 'PATCH',
            headers: {
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || '',
              'Accept': 'application/json'
            },
            credentials: 'same-origin'
          });

          const payload = await response.json();
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Move to Complete failed');

          if (!modal.classList.contains('hidden') && activeCardId === String(cardId)) {
            await openNextReviewTask(cardId);
          } else {
            await refreshBoard();
          }
        } catch (error) {
          console.error(error);
          alert('Could not move the task to Complete.');
          markCompleteButton.disabled = false;
          fields.markComplete.disabled = false;
        }

        return;
      }

      const moveBacklogButton = event.target.closest('.js-move-backlog-card');
      if (moveBacklogButton) {
        event.preventDefault();
        event.stopPropagation();

        const cardId = moveBacklogButton.dataset.cardId;
        const currentStatus = moveBacklogButton.dataset.cardStatus;
        const targetStatus = moveBacklogButton.dataset.targetStatus;
        const targetLabel = (targetStatus || 'backlog').replace(/_/g, ' ');
        if (!cardId || !targetStatus) return;
        const needsConfirmation = !(currentStatus === 'icebox' && targetStatus === 'queued');
        if (needsConfirmation && !window.confirm(`Move this task to ${targetLabel}?`)) return;

        moveBacklogButton.disabled = true;

        try {
          const response = await fetch(`/kanban/cards/${cardId}/move_backlog`, {
            method: 'PATCH',
            headers: {
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || '',
              'Accept': 'application/json',
              'Content-Type': 'application/json'
            },
            credentials: 'same-origin',
            body: JSON.stringify({ target_status: targetStatus })
          });

          const payload = await response.json();
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Move backlog failed');

          if (!modal.classList.contains('hidden') && activeCardId === String(cardId)) closeModal();
          await refreshBoard();
        } catch (error) {
          console.error(error);
          alert(`Could not move the task to ${targetLabel}.`);
          moveBacklogButton.disabled = false;
        }

        return;
      }

      const archiveButton = event.target.closest('.js-archive-card');
      if (archiveButton) {
        event.preventDefault();
        event.stopPropagation();

        const cardId = archiveButton.dataset.cardId;
        const currentStatus = (archiveButton.dataset.cardStatus || 'current').replace(/_/g, ' ');
        if (!cardId) return;
        if (!window.confirm(`Archive this ${currentStatus} task?`)) return;

        archiveButton.disabled = true;

        try {
          const response = await fetch(`/kanban/cards/${cardId}`, {
            method: 'DELETE',
            headers: {
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || '',
              'Accept': 'application/json'
            },
            credentials: 'same-origin'
          });

          const payload = await response.json();
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Archive failed');

          const card = document.querySelector(`[data-kanban-card-id="${cardId}"]`);
          if (card) card.remove();
          if (!modal.classList.contains('hidden')) closeModal();
          refreshBoard();
        } catch (error) {
          console.error(error);
          alert('Could not archive the task.');
          archiveButton.disabled = false;
        }

        return;
      }

      const openButton = event.target.closest('.js-open-card-modal');
      if (openButton) {
        event.preventDefault();
        openModal(openButton);
        return;
      }

      if (event.target.closest('.js-close-card-modal')) {
        closeModal();
        return;
      }

      // Close when clicking the backdrop or the outer modal container (not inside the card panel)
      if (!modal.classList.contains('hidden')) {
        const cardPanel = modal.querySelector('.max-w-5xl');
        if (cardPanel && !cardPanel.contains(event.target)) {
          closeModal();
        }
      }
    });

    document.addEventListener('keydown', (event) => {
      const createTaskModalElement = createTaskModal();
      if (event.key === 'Escape') {
        if (createTaskModalElement && !createTaskModalElement.classList.contains('hidden')) {
          closeCreateTaskModal();
          return;
        }

        if (!modal.classList.contains('hidden')) {
          closeModal();
          return;
        }
      }

      if (modal.classList.contains('hidden')) return;
      if (event.target.closest('input, textarea, select, [contenteditable="true"]')) return;

      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        openAdjacentCard(-1);
        return;
      }

      if (event.key === 'ArrowRight') {
        event.preventDefault();
        openAdjacentCard(1);
      }
    });

    fields.prev?.addEventListener('click', () => openAdjacentCard(-1));
    fields.next?.addEventListener('click', () => openAdjacentCard(1));

    // Handle browser back/forward
    window.addEventListener('popstate', (event) => {
      const cardId = event.state?.cardId;
      if (cardId) {
        const btn = findButtonByCardId(cardId);
        if (btn) { openModal(btn); return; }
      }
      closeModal();
    });

    const projectFilterForm = document.getElementById('kanban-project-filter-form');
    const projectFilterSelect = projectFilterForm?.querySelector('[data-auto-submit="true"]');
    projectFilterSelect?.addEventListener('change', () => {
      if (projectFilterForm.requestSubmit) {
        projectFilterForm.requestSubmit();
      } else {
        projectFilterForm.submit();
      }
    });

    applyAllColumnSorts();

    // Auto-open card from ?card= deep link on page load
    const initialCardId = new URL(window.location.href).searchParams.get('card');
    if (initialCardId) {
      const btn = findButtonByCardId(initialCardId);
      if (btn) openModal(btn);
    }
  })();
</script>
