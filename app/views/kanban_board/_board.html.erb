<%
  column_meta = {
    'icebox' => { title: 'Icebox', subtitle: 'Parked tasks and long-tail backlog', shell_class: 'border-slate-200 bg-white', accent_class: 'bg-slate-500', count_class: 'bg-slate-100 text-slate-700' },
    'queued' => { title: 'Queued', subtitle: 'Tasks waiting for pickup', shell_class: 'border-slate-200 bg-white', accent_class: 'bg-violet-500', count_class: 'bg-violet-50 text-violet-700' },
    'in_progress' => { title: 'In Progress', subtitle: 'Live lane heartbeat activity', shell_class: 'border-sky-200 bg-sky-50/60', accent_class: 'bg-sky-500', count_class: 'bg-sky-100 text-sky-700' },
    'ready_for_review' => { title: 'Ready for review', subtitle: 'Waiting on review or QA', shell_class: 'border-amber-200 bg-amber-50/60', accent_class: 'bg-amber-500', count_class: 'bg-amber-100 text-amber-700' },
    'complete' => { title: 'Complete', subtitle: 'Delivered work with review-ready activity', shell_class: 'border-emerald-200 bg-emerald-50/60', accent_class: 'bg-emerald-500', count_class: 'bg-emerald-100 text-emerald-700' }
  }
%>

<section class="mt-8" id="kanban-board" data-live-region="kanban-board" data-live-updated-at="<%= @board_updated_at&.utc&.iso8601(6) %>">
  <div class="mb-4 flex flex-col gap-3 rounded-[1.75rem] border border-slate-200/80 bg-white/90 px-4 py-4 text-sm text-slate-600 shadow-[0_20px_60px_-40px_rgba(15,23,42,0.55)] backdrop-blur sm:px-5">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex items-center gap-3">
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200/80">
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
        </span>
        <div>
          <div class="text-[11px] font-semibold uppercase tracking-[0.28em] text-emerald-700">Live board</div>
          <div class="mt-1 text-sm font-medium text-slate-700">Auto-refresh is on. Board checks for updates every 15 seconds.</div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600">
          Last board update
          <span class="text-slate-900" data-live-updated-label><%= @board_updated_at ? @board_updated_at.utc.strftime('%Y-%m-%d %H:%M:%S UTC') : 'Unknown' %></span>
        </span>
        <% if @columns.fetch('complete').any? %>
          <button type="button"
                  class="inline-flex items-center justify-center rounded-full border border-amber-200 bg-amber-50 px-3.5 py-2 text-xs font-semibold text-amber-700 transition hover:bg-amber-100 hover:text-amber-800 js-archive-all-complete"
                  data-project-id="<%= @selected_project.to_s %>">
            Archive all complete
          </button>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid gap-3 md:gap-4 xl:grid-cols-5">
    <% KanbanBoardController::COLUMN_ORDER.each do |key| %>
      <% meta = column_meta.fetch(key) %>
      <% cards = @columns.fetch(key) %>
      <% default_sort = kanban_sort_defaults.fetch(key, 'oldest') %>
      <section class="flex min-h-[9.5rem] flex-col rounded-[1.4rem] border p-3 shadow-sm shadow-slate-900/5 sm:min-h-[11rem] sm:rounded-[1.55rem] sm:p-4 xl:min-h-[36rem] xl:rounded-[1.75rem] <%= meta[:shell_class] %>" data-kanban-column="<%= key %>" data-sort-default="<%= default_sort %>">
        <div class="mb-3 flex items-start justify-between gap-3 border-b border-slate-200/70 pb-3 sm:mb-4 sm:pb-4">
          <div>
            <div class="flex items-center gap-2">
              <span class="inline-flex h-2.5 w-2.5 rounded-full <%= meta[:accent_class] %>"></span>
              <h3 class="text-lg font-semibold text-slate-950"><%= meta[:title] %></h3>
            </div>
            <p class="mt-1.5 text-xs leading-5 text-slate-500 sm:mt-2 sm:text-sm sm:leading-6"><%= meta[:subtitle] %></p>
          </div>
          <div class="flex items-center gap-2 self-start">
            <button type="button"
                    class="js-kanban-column-sort inline-flex h-7 w-7 items-center justify-center rounded-full border border-slate-200 bg-white text-xs font-semibold text-slate-600 transition hover:border-slate-300 hover:text-slate-900"
                    data-column-key="<%= key %>"
                    data-sort-default="<%= default_sort %>"
                    title="<%= default_sort == 'newest' ? 'Sorted newest first — click to switch to oldest first' : 'Sorted oldest first — click to switch to newest first' %>"
                    aria-label="<%= default_sort == 'newest' ? 'Sorted newest first — click to switch to oldest first' : 'Sorted oldest first — click to switch to newest first' %>">
              <span class="js-kanban-column-sort-icon block leading-none transition-transform duration-150" aria-hidden="true"><%= default_sort == 'newest' ? '↓' : '↑' %></span>
            </button>
            <span class="inline-flex h-7 min-w-[2.25rem] items-center justify-center rounded-full px-3 text-xs font-semibold <%= meta[:count_class] %>"><%= cards.size %></span>
          </div>
        </div>

        <div class="flex flex-1 flex-col gap-2.5 sm:gap-3" data-kanban-column-cards>
          <% if cards.any? %>
            <% cards.each do |item| %>
              <% description_text = markdown_plain_text(item.description).presence || activity_feed_preview(item) %>
              <% tags = Array(item.try(:tags) || item.try(:tag_list)).compact.reject(&:blank?) %>
              <% review_links = review_links_for(item) %>
              <% timeout_recommendation = item.try(:timeout_recommendation).to_s.strip %>
              <% completion_duration = completion_duration_label(item) %>
              <% metadata_bits = [] %>
              <% metadata_bits << item.lane if item.lane.present? %>
              <% metadata_bits << item.worker if item.worker.present? && item.worker != item.lane %>
              <article class="group rounded-[1.2rem] border border-slate-200 bg-white p-3 shadow-sm shadow-slate-900/5 transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md sm:rounded-[1.5rem] sm:p-4" data-kanban-card-id="<%= item.id if item.is_a?(KanbanCard) %>" data-card-sort-timestamp="<%= kanban_sort_timestamp_for(item, key) %>">
                <button type="button"
                        class="w-full text-left js-open-card-modal"
                        data-card-id="<%= item.id if item.is_a?(KanbanCard) %>"
                        data-card-title="<%= item.title %>"
                        data-card-id-label="<%= item.try(:display_task_id) || item.try(:task_number) || item.try(:external_id).presence || item.id %>"
                        data-card-project="<%= item.try(:project_name) || KanbanCard::NO_PROJECT %>"
                        data-card-status="<%= meta[:title] %>"
                        data-card-status-key="<%= key %>"
                        data-card-description-html="<%= ERB::Util.html_escape_once(render_markdown(item.description.to_s)).html_safe %>"
                        data-card-activity-html="<%= ERB::Util.html_escape_once(activity_feed_html(item)).html_safe %>"
                        data-card-review-focus-html="<%= ERB::Util.html_escape_once(render_markdown([item.review_focus.to_s.presence, (timeout_recommendation.present? ? "## Timeout recommendation\n\n#{timeout_recommendation}" : nil)].compact.join("\n\n"))).html_safe %>"
                        data-card-review-links="<%= review_links.join("\n") %>"
                        data-card-lane="<%= item.lane.to_s %>"
                        data-card-worker="<%= item.worker.to_s %>"
                        data-card-tags="<%= tags.join(' • ') %>"
                        data-card-live="<%= key == 'in_progress' %>"
                        data-card-completion-duration="<%= completion_duration.to_s %>"
                        data-card-has-requeue-recommendation="<%= timeout_recommendation.present? %>">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <div class="text-[11px] font-semibold uppercase tracking-[0.24em] text-sky-700">Task #<%= item.try(:display_task_id) || item.try(:task_number) || item.try(:external_id).presence || item.id %></div>
                      <h4 class="mt-2 line-clamp-2 text-base font-semibold leading-6 tracking-[-0.02em] text-slate-950 group-hover:text-slate-700"><%= item.title %></h4>
                    </div>
                    <span class="inline-flex h-9 w-9 flex-none items-center justify-center rounded-full bg-slate-100 text-slate-400 transition group-hover:bg-slate-900 group-hover:text-white">→</span>
                  </div>

                  <div class="mt-3 flex flex-wrap gap-2">
                    <span class="inline-flex items-center rounded-full border border-sky-100 bg-sky-50 px-2.5 py-1 text-[11px] font-semibold text-sky-700"><%= item.try(:project_name) || KanbanCard::NO_PROJECT %></span>
                    <% metadata_bits.first(2).each do |bit| %>
                      <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold text-slate-600"><%= bit %></span>
                    <% end %>
                    <% if tags.any? %>
                      <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold text-slate-600"><%= pluralize(tags.size, 'tag') %></span>
                    <% end %>
                  </div>

                  <% if review_links.any? && key.in?(%w[ready_for_review complete]) %>
                    <div class="mt-3 flex flex-wrap gap-2">
                      <span class="inline-flex items-center justify-center rounded-full border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700"><%= pluralize(review_links.size, 'review link') %> available</span>
                    </div>
                  <% end %>

                  <p class="mt-2.5 line-clamp-3 text-sm leading-5 text-slate-600 sm:mt-3 sm:line-clamp-4 sm:leading-6"><%= truncate(description_text, length: 180) %></p>

                  <% if key == 'in_progress' %>
                    <div class="mt-4 flex flex-wrap gap-2">
                      <% since = item.try(:in_progress_since) || item.try(:updated_at) %>
                      <% if since %>
                        <div class="inline-flex items-center rounded-full px-3 py-1.5 text-xs font-semibold ring-1 <%= in_progress_elapsed_badge_classes(since) %>" title="In progress since <%= since.utc.strftime('%Y-%m-%d %H:%M UTC') %>">⏱ <%= in_progress_elapsed_badge_label(since) %></div>
                      <% end %>
                    </div>
                  <% elsif key.in?(%w[complete ready_for_review]) %>
                    <div class="mt-4 flex flex-wrap gap-2">
                      <% if completion_duration.present? %>
                        <div class="inline-flex items-center rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-100" title="Time from In progress to Ready for review">⏱ Completed in <%= completion_duration %></div>
                      <% end %>
                      <% if item.review_focus.present? || item.try(:activity_entries_list).present? || timeout_recommendation.present? %>
                        <div class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600"><%= timeout_recommendation.present? ? 'Timed out with recommendation' : 'Has review context' %></div>
                      <% end %>
                    </div>
                  <% end %>
                </button>

                <% if item.is_a?(KanbanCard) %>
                  <div class="mt-4 flex flex-wrap justify-end gap-2 border-t border-slate-100 pt-3">
                    <% if key == 'ready_for_review' %>
                      <% if timeout_recommendation.present? %>
                        <button type="button"
                                class="inline-flex items-center justify-center rounded-full border border-sky-300 bg-sky-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm shadow-sky-600/20 transition hover:bg-sky-700 js-requeue-card"
                                title="Requeue with recommendation"
                                aria-label="Requeue with recommendation"
                                data-card-id="<%= item.id %>"
                                data-requeue-mode="recommendation">
                          Requeue with recommendation
                        </button>
                        <button type="button"
                                class="inline-flex items-center justify-center rounded-full border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 shadow-sm shadow-slate-900/5 transition hover:bg-slate-50 js-requeue-card"
                                title="Requeue with original instructions"
                                aria-label="Requeue with original instructions"
                                data-card-id="<%= item.id %>"
                                data-requeue-mode="original">
                          Requeue with original instructions
                        </button>
                      <% end %>
                      <button type="button"
                              class="inline-flex items-center justify-center rounded-full border border-emerald-300 bg-emerald-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm shadow-emerald-600/20 transition hover:bg-emerald-700 js-mark-complete-card"
                              title="Move task to Complete"
                              aria-label="Move task to Complete"
                              data-card-id="<%= item.id %>">
                        Mark complete
                      </button>
                    <% elsif key == 'queued' %>
                      <button type="button"
                              class="inline-flex items-center justify-center rounded-full border border-slate-300 bg-slate-50 px-3.5 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-100 hover:text-slate-900 js-move-backlog-card"
                              title="Move task to Icebox"
                              aria-label="Move task to Icebox"
                              data-card-id="<%= item.id %>"
                              data-card-status="<%= item.status %>"
                              data-target-status="icebox">
                        Move to Icebox
                      </button>
                    <% elsif key == 'icebox' %>
                      <button type="button"
                              class="inline-flex items-center justify-center rounded-full border border-violet-200 bg-violet-50 px-3.5 py-2 text-xs font-semibold text-violet-700 transition hover:bg-violet-100 hover:text-violet-800 js-move-backlog-card"
                              title="Move task to Queue"
                              aria-label="Move task to Queue"
                              data-card-id="<%= item.id %>"
                              data-card-status="<%= item.status %>"
                              data-target-status="queued">
                        Move to Queue
                      </button>
                    <% elsif key == 'complete' %>
                      <button type="button"
                              class="inline-flex items-center justify-center rounded-full border border-amber-200 bg-amber-50 px-3.5 py-2 text-xs font-semibold text-amber-700 transition hover:bg-amber-100 hover:text-amber-800 js-archive-card"
                              title="Archive task"
                              aria-label="Archive task"
                              data-card-id="<%= item.id %>"
                              data-card-status="<%= item.status %>">
                        Archive
                      </button>
                    <% end %>
                  </div>
                <% end %>
              </article>
            <% end %>
          <% else %>
            <div class="flex min-h-[5.5rem] items-center justify-center rounded-[1.2rem] border border-dashed border-slate-300 bg-white/75 px-4 py-3 text-center text-sm leading-5 text-slate-500 sm:min-h-[7rem] sm:rounded-[1.5rem] sm:p-5 sm:leading-6 xl:min-h-[12rem]">No cards in this column right now.</div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</section>
