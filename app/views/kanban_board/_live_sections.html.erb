<div id="kanban-live-sections">
  <section class="mt-5 overflow-hidden rounded-[1.5rem] border border-slate-200/70 bg-white shadow-[0_24px_80px_-42px_rgba(15,23,42,0.45)] sm:mt-6 sm:rounded-[2rem]">
    <div class="border-b border-slate-100 px-5 py-4 sm:px-6" data-live-region="project-filter">
      <%= form_with url: kanban_path, method: :get, local: true, class: 'flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between', html: { id: 'kanban-project-filter-form' } do |f| %>
        <div>
          <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Project scope</div>
          <div class="mt-1 text-sm text-slate-600">Changing the project filter updates the board immediately.</div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <label class="inline-flex items-center gap-3 rounded-full border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-800 shadow-sm shadow-sky-100/50">
            <span class="pl-1">Project</span>
            <span class="relative inline-flex items-center">
              <%= f.select :project_id, options_for_select([['All projects', '']] + @project_options.map { |project| [project.name, project.id] } + [[KanbanCard::NO_PROJECT, 'none']], @selected_project), {}, class: 'appearance-none rounded-full border border-sky-200 bg-white pl-4 pr-10 py-2 text-sm font-semibold text-sky-950 focus:border-sky-300 focus:outline-none focus:ring-2 focus:ring-sky-100', data: { auto_submit: true } %>
              <span class="pointer-events-none absolute right-3 inline-flex h-7 w-7 items-center justify-center rounded-full bg-sky-50 text-sky-700 ring-1 ring-sky-100">
                <svg viewBox="0 0 20 20" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
                  <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </span>
          </label>
        </div>
      <% end %>
    </div>

    <div class="grid gap-3 px-4 py-4 sm:gap-4 sm:px-6 sm:py-5 xl:grid-cols-3">
      <div class="rounded-[1.6rem] border border-slate-200 bg-slate-50 p-5" data-live-region="worker-density">
        <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Worker density</div>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 ring-1 ring-slate-200">
            <span class="h-2 w-2 rounded-full bg-slate-400"></span>
            <%= @workers.size %> Workers
          </span>
          <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-100">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            <%= @columns.fetch('in_progress').size %> Active
          </span>
          <span class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-700 ring-1 ring-blue-100">
            <span class="h-2 w-2 rounded-full bg-blue-500"></span>
            <%= @workers.count { |w| !w[:active] } %> Idle
          </span>
        </div>
      </div>
      <div class="rounded-[1.6rem] border border-slate-200 bg-white p-5 shadow-sm" data-live-region="project-summary">
        <div class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-700">Project summary</div>
        <div class="mt-4 grid gap-3 text-sm text-slate-600 sm:grid-cols-2">
          <div class="flex items-center justify-between gap-3 rounded-2xl bg-slate-100 px-4 py-3"><span>Total cards</span><span class="font-semibold text-slate-900"><%= KanbanBoardController::COLUMN_ORDER.sum { |key| @columns.fetch(key).size } %></span></div>
          <div class="flex items-center justify-between gap-3 rounded-2xl bg-sky-50 px-4 py-3"><span>In progress</span><span class="font-semibold text-sky-800"><%= @columns.fetch('in_progress').size %></span></div>
        </div>
      </div>
      <div class="rounded-[1.6rem] border border-dashed border-slate-300 bg-white/70 p-5" data-live-region="active-workers">
        <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Active workers</div>
        <div class="mt-4 flex flex-wrap gap-1.5">
          <% @workers.select { |w| w[:active] }.each do |worker| %>
            <% badge_classes = worker[:desynced] ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800' %>
            <% title_bits = [worker[:task], worker[:desync_reason], (worker[:heartbeat_updated_at]&.utc&.strftime('%Y-%m-%d %H:%M:%S UTC') if worker[:heartbeat_updated_at])].compact %>
            <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[11px] font-bold <%= badge_classes %>" title="<%= title_bits.join(' · ') %>">
              <%= worker[:name] %>
              <% if worker[:desynced] %><span>⚠</span><% end %>
            </span>
          <% end %>
          <% if @workers.none? { |w| w[:active] } %>
            <span class="text-sm italic text-slate-400">No active workers</span>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <div id="kanban-create-task-modal" class="fixed inset-0 z-50 <%= @new_card.errors.any? ? '' : 'hidden' %>" aria-hidden="<%= @new_card.errors.any? ? 'false' : 'true' %>">
    <div class="js-create-task-modal-backdrop absolute inset-0 bg-slate-950/60 backdrop-blur-sm"></div>
    <div class="relative flex min-h-full items-end justify-center p-2 sm:items-center sm:p-6">
      <div class="js-create-task-modal-panel flex max-h-[calc(100vh-1rem)] w-full max-w-3xl flex-col overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_40px_120px_-30px_rgba(15,23,42,0.55)] sm:max-h-[calc(100vh-3rem)]">
        <div class="flex items-start justify-between gap-4 border-b border-slate-100 px-6 py-5 sm:px-7 sm:py-6">
          <div>
            <div class="text-[11px] font-black uppercase tracking-[0.32em] text-violet-600">Manual task creation</div>
            <h3 class="mt-2 text-2xl font-semibold leading-tight tracking-[-0.03em] text-slate-950 sm:text-[1.75rem]">Create a Kanban task</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">Same setup flow, cleaner presentation. Works well on desktop and mobile.</p>
          </div>
          <button type="button" class="js-close-create-task-modal inline-flex h-10 w-10 flex-none items-center justify-center rounded-full bg-slate-100 text-xl text-slate-400 transition hover:bg-slate-200 hover:text-slate-700" aria-label="Close create task modal">×</button>
        </div>

        <div class="min-h-0 overflow-y-auto px-5 py-5 sm:px-6 sm:py-6">
          <% if @new_card.errors.any? %>
            <div class="mb-4 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700">
              <%= @new_card.errors.full_messages.to_sentence %>
            </div>
          <% end %>

          <%= form_with model: @new_card, url: kanban_cards_path(project_id: @selected_project.presence), method: :post, local: true, class: 'grid gap-4 lg:grid-cols-2' do |f| %>
            <div class="lg:col-span-2">
              <%= f.label :title, 'Title', class: 'mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-slate-500' %>
              <%= f.text_field :title, required: true, placeholder: 'Add manual task title', autofocus: true, class: 'w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100' %>
            </div>

            <div>
              <%= f.label :project_id, 'Project', class: 'mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-slate-500' %>
              <%= f.select :project_id, options_for_select([['No project', '']] + @project_options.map { |project| [project.name, project.id] }, @new_card.project_id), {}, class: 'w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100' %>
            </div>

            <div>
              <%= f.label :status, 'Start in', class: 'mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-slate-500' %>
              <%= f.select :status, options_for_select([['Queued', 'queued'], ['Icebox', 'icebox']], @new_card.status.presence || 'queued'), {}, class: 'w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100' %>
            </div>

            <div class="lg:col-span-2">
              <%= f.label :description, 'Description (Markdown)', class: 'mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-slate-500' %>
              <%= f.text_area :description, rows: 7, placeholder: "## Goal\n\n- Add the task\n- Keep raw Markdown in storage", class: 'w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm leading-6 text-slate-900 outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100' %>
            </div>

            <div class="lg:col-span-2 flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">
              <p class="text-xs leading-5 text-slate-500">Description stays markdown-first. Initial activity has been removed.</p>
              <%= f.submit 'Create task', class: 'inline-flex items-center justify-center rounded-2xl border border-violet-300 bg-violet-600 px-5 py-3 text-sm font-semibold text-white shadow-sm shadow-violet-600/20 transition hover:bg-violet-700' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%= render 'board' %>
</div>
