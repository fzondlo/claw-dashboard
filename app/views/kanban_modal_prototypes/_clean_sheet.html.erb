<%# Prototype A: Clean Sheet — light, spacious, bold amber review banner %>
<div class="w-full max-w-2xl bg-white rounded-[2rem] shadow-[0_40px_100px_-20px_rgba(15,23,42,0.45)] overflow-hidden">

  <%# Header %>
  <div class="px-7 pt-6 pb-5 border-b border-slate-100 flex items-start justify-between gap-4">
    <div>
      <div class="text-[11px] font-black uppercase tracking-[0.32em] text-sky-600">Task #41 · Dashboard</div>
      <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-slate-950 leading-tight">Redesign the task modal for Ready for Review state</h2>
    </div>
    <button class="flex-none inline-flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-slate-400 hover:bg-slate-200 text-lg">×</button>
  </div>

  <%# Ready for Review banner %>
  <div class="mx-6 mt-5 rounded-2xl bg-gradient-to-r from-amber-50 to-yellow-50 border border-amber-200 px-5 py-4 flex items-center justify-between gap-4">
    <div>
      <div class="text-[11px] font-black uppercase tracking-[0.28em] text-amber-700">Ready for review</div>
      <p class="mt-1 text-sm font-medium text-amber-900">This task is waiting on your sign-off.</p>
    </div>
    <div class="flex gap-2 flex-wrap">
      <button class="inline-flex items-center gap-1.5 rounded-xl border border-amber-300 bg-white px-4 py-2 text-sm font-semibold text-amber-800 hover:bg-amber-50 transition">← Prev</button>
      <button class="inline-flex items-center gap-1.5 rounded-xl border border-amber-300 bg-white px-4 py-2 text-sm font-semibold text-amber-800 hover:bg-amber-50 transition">Next →</button>
      <button class="inline-flex items-center gap-1.5 rounded-xl border border-emerald-500 bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 transition">✓ Mark complete</button>
    </div>
  </div>

  <%# Review link %>
  <div class="mx-6 mt-3 rounded-2xl bg-sky-50 border border-sky-200 px-5 py-3 flex items-center justify-between">
    <div>
      <div class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-700">Review link</div>
      <p class="text-sm text-slate-600 mt-0.5">https://dash.zevner.com/kanban</p>
    </div>
    <a href="#" class="inline-flex items-center gap-1.5 rounded-xl border border-sky-300 bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700 transition">Open ↗</a>
  </div>

  <%# Body %>
  <div class="px-6 pb-6 mt-5 grid grid-cols-2 gap-3">
    <div class="col-span-2 rounded-2xl border border-slate-100 bg-slate-50 px-4 py-3">
      <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 mb-2">Description</div>
      <p class="text-sm text-slate-700 leading-6">Create 2–3 polished modal prototypes for the Ready for Review task state so Frank can pick one before production rollout.</p>
    </div>
    <div class="rounded-2xl border border-slate-100 bg-slate-50 px-4 py-3">
      <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 mb-2">Lane / Worker</div>
      <p class="text-sm font-medium text-slate-800">pixi8</p>
    </div>
    <div class="rounded-2xl border border-slate-100 bg-slate-50 px-4 py-3">
      <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 mb-2">Priority</div>
      <span class="inline-flex rounded-full bg-red-50 border border-red-200 px-3 py-0.5 text-xs font-semibold text-red-700">High</span>
    </div>
    <div class="col-span-2 rounded-2xl border border-slate-100 bg-slate-50 px-4 py-3">
      <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 mb-2">Review notes</div>
      <p class="text-sm text-slate-700 leading-6">Prototype A: clean-sheet. Prototype B: dark-card. Prototype C: split-panel. QA all three, pick one.</p>
    </div>
  </div>
</div>
