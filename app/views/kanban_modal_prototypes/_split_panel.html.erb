<%# Prototype C: Split Panel — metadata left, review actions right %>
<div class="w-full max-w-3xl bg-white rounded-[2rem] shadow-[0_40px_100px_-20px_rgba(15,23,42,0.5)] overflow-hidden flex flex-col">

  <%# Header %>
  <div class="px-7 pt-6 pb-5 border-b border-slate-100 flex items-start justify-between gap-4">
    <div>
      <div class="text-[11px] font-black uppercase tracking-[0.32em] text-sky-600">Task #41 · Dashboard</div>
      <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-slate-950 leading-tight">Redesign the task modal for Ready for Review state</h2>
    </div>
    <button class="flex-none inline-flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-slate-400 hover:bg-slate-200 text-lg">×</button>
  </div>

  <%# Two-column body %>
  <div class="flex divide-x divide-slate-100 min-h-0 max-h-[75vh]">

    <%# Left: content %>
    <div class="flex-1 overflow-y-auto px-6 py-5 space-y-4">
      <div class="rounded-2xl border border-slate-100 bg-slate-50 px-4 py-4">
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 mb-2">Description</div>
        <p class="text-sm text-slate-700 leading-6">Create 2–3 polished modal prototypes for the Ready for Review task state so Frank can pick one before production rollout.</p>
      </div>
      <div class="rounded-2xl border border-slate-100 bg-slate-50 px-4 py-4">
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 mb-2">Review notes</div>
        <p class="text-sm text-slate-700 leading-6">Prototype A: clean-sheet. Prototype B: dark-card. Prototype C: split-panel. QA all three, pick one.</p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="rounded-2xl border border-slate-100 bg-slate-50 px-4 py-3">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 mb-1">Worker</div>
          <p class="text-sm font-medium text-slate-800">pixi8</p>
        </div>
        <div class="rounded-2xl border border-slate-100 bg-slate-50 px-4 py-3">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 mb-1">Priority</div>
          <span class="inline-flex rounded-full bg-red-50 border border-red-200 px-3 py-0.5 text-xs font-semibold text-red-700">High</span>
        </div>
      </div>
    </div>

    <%# Right: review actions panel %>
    <div class="w-64 flex-none flex flex-col bg-slate-50 px-5 py-5 gap-4">
      <div>
        <div class="text-[11px] font-black uppercase tracking-[0.28em] text-amber-700">Ready for review</div>
        <p class="mt-1.5 text-xs text-slate-500 leading-5">Review the linked output, then mark complete or navigate to the next task.</p>
      </div>

      <a href="#" class="w-full inline-flex items-center justify-center gap-2 rounded-2xl border border-sky-300 bg-sky-600 px-4 py-3 text-sm font-semibold text-white shadow hover:bg-sky-700 transition">Open review link ↗</a>

      <div class="border-t border-slate-200 pt-4 space-y-2">
        <button class="w-full inline-flex items-center justify-center gap-2 rounded-2xl border border-emerald-400 bg-emerald-600 px-4 py-3 text-sm font-semibold text-white shadow hover:bg-emerald-700 transition">✓ Mark complete</button>
        <div class="flex gap-2">
          <button class="flex-1 inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-100 transition">← Prev</button>
          <button class="flex-1 inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-100 transition">Next →</button>
        </div>
      </div>

      <div class="mt-auto pt-4 border-t border-slate-200">
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400 mb-2">Status</div>
        <span class="inline-flex rounded-full bg-amber-100 border border-amber-200 px-3 py-1 text-xs font-semibold text-amber-800">Ready for review</span>
      </div>
    </div>
  </div>
</div>
