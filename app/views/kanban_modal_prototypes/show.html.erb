<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= @meta[:name] %> — Modal Prototype</title>
  <%= stylesheet_link_tag "application", media: "all" %>
  <style>
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif; }
  </style>
</head>
<body class="bg-slate-100 min-h-screen">

  <%# Nav bar %>
  <div class="border-b border-slate-200 bg-white px-6 py-4 flex items-center justify-between">
    <div>
      <span class="text-[11px] font-semibold uppercase tracking-[0.28em] text-sky-600"><%= @meta[:eyebrow] %></span>
      <h1 class="text-lg font-semibold text-slate-900 mt-0.5"><%= @meta[:name] %></h1>
    </div>
    <div class="flex gap-3 text-sm">
      <% KanbanModalPrototypesController::VARIANTS.each do |slug, v| %>
        <%= link_to v[:eyebrow], kanban_modal_prototype_path(variant: slug),
            class: "px-4 py-2 rounded-full font-medium transition #{slug == @variant ? 'bg-sky-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}" %>
      <% end %>
      <%= link_to '← Back to board', kanban_path, class: 'px-4 py-2 rounded-full bg-slate-100 text-slate-600 font-medium hover:bg-slate-200' %>
    </div>
  </div>

  <%# Description %>
  <div class="mx-auto mt-6 max-w-6xl px-6">
    <div class="grid gap-4 xl:grid-cols-[minmax(0,1.25fr)_minmax(20rem,0.75fr)]">
      <div>
        <p class="text-sm text-slate-500"><%= @meta[:description] %></p>
      </div>
      <div class="rounded-[1.5rem] border border-slate-200 bg-white/80 px-5 py-4 shadow-sm shadow-slate-900/5 backdrop-blur">
        <div class="text-[11px] font-semibold uppercase tracking-[0.24em] text-sky-700">Review target</div>
        <div class="mt-2 text-sm font-semibold text-slate-900">Ready for Review modal redesign</div>
        <p class="mt-2 text-sm leading-6 text-slate-600">Prototype C is the intended direction. These preview pages are styled to feel close to a production Dash review flow so Frank can pick the treatment before rollout.</p>
      </div>
    </div>
  </div>

  <%# Simulated board backdrop %>
  <div class="relative mt-6 min-h-[90vh] overflow-hidden">
    <%# Blurred board behind %>
    <div class="blur-sm opacity-40 px-6 grid grid-cols-4 gap-4">
      <% 4.times do |col| %>
        <div class="rounded-[1.5rem] border border-slate-200 bg-white p-4 space-y-3">
          <div class="h-3 bg-slate-200 rounded-full w-1/2"></div>
          <% 3.times do %>
            <div class="rounded-2xl border border-slate-100 bg-slate-50 p-3 space-y-2">
              <div class="h-2 bg-slate-300 rounded-full w-3/4"></div>
              <div class="h-2 bg-slate-200 rounded-full w-full"></div>
              <div class="h-2 bg-slate-200 rounded-full w-2/3"></div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Modal overlay %>
    <div class="absolute inset-0 flex items-center justify-center p-6" style="background: rgba(15,23,42,0.55); backdrop-filter: blur(4px);">
      <% if @variant == 'clean-sheet' %>
        <%= render partial: 'clean_sheet' %>
      <% elsif @variant == 'dark-card' %>
        <%= render partial: 'dark_card' %>
      <% elsif @variant == 'split-panel' %>
        <%= render partial: 'split_panel' %>
      <% end %>
    </div>
  </div>

</body>
</html>
