<%# Prototype B: Dark Card — dark header, warm review callout %>
<div class="w-full max-w-2xl bg-white rounded-[2rem] shadow-[0_40px_100px_-20px_rgba(15,23,42,0.6)] overflow-hidden">

  <%# Dark header %>
  <div class="bg-slate-950 px-7 pt-6 pb-6 flex items-start justify-between gap-4">
    <div>
      <div class="text-[11px] font-black uppercase tracking-[0.32em] text-sky-400">Task #41 · Dashboard</div>
      <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white leading-tight">Redesign the task modal for Ready for Review state</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        <span class="inline-flex rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-slate-300">pixi8</span>
        <span class="inline-flex rounded-full bg-red-500/20 border border-red-400/30 px-3 py-1 text-xs font-semibold text-red-300">High</span>
        <span class="inline-flex rounded-full bg-amber-400/20 border border-amber-400/30 px-3 py-1 text-xs font-semibold text-amber-300">Ready for review</span>
      </div>
    </div>
    <button class="flex-none inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-slate-400 hover:bg-white/20 text-lg">×</button>
  </div>

  <div class="px-6 py-5 space-y-4">
    <%# Review callout %>
    <div class="rounded-2xl bg-amber-50 border border-amber-200 px-5 py-4">
      <div class="flex items-center justify-between gap-4 flex-wrap">
        <div>
          <div class="text-[11px] font-black uppercase tracking-[0.28em] text-amber-700">Waiting on review</div>
          <p class="mt-1 text-sm font-medium text-amber-900">Open the link and mark complete when approved.</p>
        </div>
        <div class="flex gap-2 flex-wrap">
          <button class="inline-flex items-center rounded-xl border border-amber-300 bg-white px-4 py-2 text-sm font-semibold text-amber-800 hover:bg-amber-50">← Prev</button>
          <button class="inline-flex items-center rounded-xl border border-amber-300 bg-white px-4 py-2 text-sm font-semibold text-amber-800 hover:bg-amber-50">Next →</button>
          <button class="inline-flex items-center rounded-xl border border-emerald-500 bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-emerald-700">✓ Mark complete</button>
        </div>
      </div>
      <a href="#" class="mt-3 inline-flex items-center gap-2 rounded-xl border border-sky-300 bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700">Open review link ↗</a>
    </div>

    <%# Description %>
    <div class="rounded-2xl border border-slate-100 bg-slate-50 px-4 py-4">
      <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 mb-2">Description</div>
      <p class="text-sm text-slate-700 leading-6">Create 2–3 polished modal prototypes for the Ready for Review task state so Frank can pick one before production rollout.</p>
    </div>

    <%# Review notes %>
    <div class="rounded-2xl border border-slate-100 bg-slate-50 px-4 py-4">
      <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 mb-2">Review notes</div>
      <p class="text-sm text-slate-700 leading-6">Prototype A: clean-sheet. Prototype B: dark-card. Prototype C: split-panel. QA all three, pick one.</p>
    </div>
  </div>
</div>
