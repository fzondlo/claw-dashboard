<div class="min-h-screen bg-slate-100 text-slate-900 lg:grid lg:grid-cols-[280px_minmax(0,1fr)]">
  <%= render "layouts/sidebar", updated_at: @updated_at %>

  <main class="bg-gradient-to-br from-slate-100 via-white to-slate-200/80 px-4 py-6 sm:px-6 lg:px-10 lg:py-8">
    <div class="flex flex-col gap-4 border-b border-slate-200/80 pb-6 xl:flex-row xl:items-end xl:justify-between">
      <div>
        <p class="text-sm font-medium text-sky-700">History</p>
        <h2 class="mt-1 text-3xl font-semibold tracking-[-0.04em] text-slate-950">Archived tasks</h2>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Browse completed and archived work with fast filters for project, original status, and other useful signals.</p>
      </div>

      <div class="grid gap-3 sm:grid-cols-3">
        <div class="rounded-[1.5rem] border border-white/70 bg-white/80 px-4 py-3 ring-1 ring-slate-200/70">
          <div class="text-[11px] font-black uppercase tracking-[0.26em] text-slate-400">Archive</div>
          <div class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-slate-950"><%= @archived_count %></div>
          <div class="text-xs text-slate-500">total tasks</div>
        </div>
        <div class="rounded-[1.5rem] border border-sky-100 bg-sky-50/90 px-4 py-3 ring-1 ring-sky-100">
          <div class="text-[11px] font-black uppercase tracking-[0.26em] text-sky-700">Visible now</div>
          <div class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-slate-950"><%= @filtered_count %></div>
          <div class="text-xs text-sky-700/80"><%= @active_filter_count.positive? ? pluralize(@active_filter_count, 'active filter') : 'all archived tasks' %></div>
        </div>
        <div class="rounded-[1.5rem] border border-amber-100 bg-amber-50/90 px-4 py-3 ring-1 ring-amber-100">
          <div class="text-[11px] font-black uppercase tracking-[0.26em] text-amber-700">Timed out</div>
          <div class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-slate-950"><%= @timed_out_count %></div>
          <div class="text-xs text-amber-700/80">needs extra scrutiny</div>
        </div>
      </div>
    </div>

    <section class="mt-8 rounded-[2rem] border border-white/70 bg-white/80 p-5 shadow-[0_30px_80px_-45px_rgba(15,23,42,0.35)] ring-1 ring-slate-200/70 backdrop-blur sm:p-6">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <div class="text-[11px] font-black uppercase tracking-[0.28em] text-slate-400">Filters</div>
          <h3 class="mt-2 text-xl font-semibold tracking-[-0.03em] text-slate-950">Find archived work quickly</h3>
          <p class="mt-1 text-sm leading-6 text-slate-500">Project and original status are up front, with extra controls for workers, lanes, dates, and timed-out runs.</p>
        </div>
        <% if @active_filter_count.positive? %>
          <%= link_to 'Clear filters', archive_path, class: 'inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-50' %>
        <% end %>
      </div>

      <%= form_with url: archive_path, method: :get, local: true, class: 'mt-6 space-y-4' do %>
        <div class="grid gap-4 xl:grid-cols-[minmax(0,1.4fr)_repeat(3,minmax(0,1fr))]">
          <div>
            <%= label_tag :query, 'Search title or notes', class: 'mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-slate-500' %>
            <%= text_field_tag :query, @filters[:query], placeholder: 'Search archived tasks…', class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:bg-white focus:ring-4 focus:ring-sky-100' %>
          </div>
          <div>
            <%= label_tag :project_id, 'Project', class: 'mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-slate-500' %>
            <%= select_tag :project_id, options_for_select([['All projects', '']] + @filter_options[:projects], @filters[:project_id]), class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:bg-white focus:ring-4 focus:ring-sky-100' %>
          </div>
          <div>
            <%= label_tag :status, 'Original status', class: 'mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-slate-500' %>
            <%= select_tag :status, options_for_select([['All statuses', '']] + @filter_options[:statuses].map { |value| [value.humanize, value] }, @filters[:status]), class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:bg-white focus:ring-4 focus:ring-sky-100' %>
          </div>
          <div>
            <%= label_tag :outcome, 'Outcome', class: 'mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-slate-500' %>
            <%= select_tag :outcome, options_for_select([['All outcomes', ''], ['Timed out', 'timed_out'], ['Normal completion', 'normal']], @filters[:outcome]), class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:bg-white focus:ring-4 focus:ring-sky-100' %>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
          <div>
            <%= label_tag :worker, 'Worker', class: 'mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-slate-500' %>
            <%= select_tag :worker, options_for_select([['All workers', '']] + @filter_options[:workers], @filters[:worker]), class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:bg-white focus:ring-4 focus:ring-sky-100' %>
          </div>
          <div>
            <%= label_tag :lane, 'Lane', class: 'mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-slate-500' %>
            <%= select_tag :lane, options_for_select([['All lanes', '']] + @filter_options[:lanes], @filters[:lane]), class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:bg-white focus:ring-4 focus:ring-sky-100' %>
          </div>
          <div>
            <%= label_tag :priority, 'Priority', class: 'mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-slate-500' %>
            <%= select_tag :priority, options_for_select([['All priorities', '']] + @filter_options[:priorities], @filters[:priority]), class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:bg-white focus:ring-4 focus:ring-sky-100' %>
          </div>
          <div>
            <%= label_tag :archived_from, 'Archived from', class: 'mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-slate-500' %>
            <%= date_field_tag :archived_from, @filters[:archived_from], class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:bg-white focus:ring-4 focus:ring-sky-100' %>
          </div>
          <div>
            <%= label_tag :archived_to, 'Archived to', class: 'mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-slate-500' %>
            <%= date_field_tag :archived_to, @filters[:archived_to], class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:bg-white focus:ring-4 focus:ring-sky-100' %>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3 border-t border-slate-100 pt-4">
          <%= submit_tag 'Apply filters', class: 'inline-flex cursor-pointer items-center justify-center rounded-2xl border border-sky-500 bg-sky-600 px-5 py-3 text-sm font-semibold text-white shadow-sm shadow-sky-600/20 transition hover:bg-sky-700' %>
          <span class="text-sm text-slate-500">Fast GET filters, no hidden state.</span>
        </div>
      <% end %>
    </section>

    <% if @archived_count.zero? %>
      <section class="mt-8 flex min-h-[18rem] items-center justify-center rounded-[2rem] border border-dashed border-slate-300 bg-white/75 p-8 text-center shadow-inner">
        <div class="max-w-md">
          <div class="text-[11px] font-black uppercase tracking-[0.3em] text-slate-400">Archive empty</div>
          <h3 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-slate-950">No archived tasks yet</h3>
          <p class="mt-3 text-sm leading-6 text-slate-500">Once work is archived from the Kanban board, it will show up here with filters and timeline details.</p>
        </div>
      </section>
    <% elsif @archived_cards.any? %>
      <section class="mt-8 grid gap-4 xl:grid-cols-2 2xl:grid-cols-3">
        <% @archived_cards.each do |item| %>
          <article class="rounded-[1.75rem] border border-white/80 bg-white/90 p-5 shadow-[0_20px_70px_-45px_rgba(15,23,42,0.45)] ring-1 ring-slate-200/70 transition hover:-translate-y-0.5 hover:shadow-[0_30px_80px_-45px_rgba(15,23,42,0.5)]">
            <div class="flex items-start justify-between gap-3">
              <div>
                <div class="flex items-center gap-2 text-[11px] font-black uppercase tracking-[0.26em] text-sky-700">
                  <span class="inline-block h-2 w-2 rounded-full bg-sky-500"></span>
                  <span>Task #<%= item.display_task_id %></span>
                </div>
                <h4 class="mt-3 text-lg font-semibold leading-7 tracking-[-0.02em] text-slate-950"><%= item.title %></h4>
              </div>
              <% if item.timed_out? %>
                <span class="inline-flex rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">Timed out</span>
              <% else %>
                <span class="inline-flex rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">Completed</span>
              <% end %>
            </div>

            <div class="mt-4 flex flex-wrap gap-2">
              <span class="inline-flex rounded-full border border-sky-100 bg-sky-50 px-2.5 py-1 text-xs font-semibold text-sky-700"><%= item.project_name %></span>
              <% if item.status.present? %>
                <span class="inline-flex rounded-full border border-slate-200 bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">Original status: <%= item.status.humanize %></span>
              <% end %>
              <% if item.worker.present? %>
                <span class="inline-flex rounded-full border border-violet-100 bg-violet-50 px-2.5 py-1 text-xs font-semibold text-violet-700"><%= item.worker %></span>
              <% end %>
              <% if item.lane.present? %>
                <span class="inline-flex rounded-full border border-fuchsia-100 bg-fuchsia-50 px-2.5 py-1 text-xs font-semibold text-fuchsia-700">Lane <%= item.lane %></span>
              <% end %>
              <% if item.priority.present? %>
                <span class="inline-flex rounded-full border border-rose-100 bg-rose-50 px-2.5 py-1 text-xs font-semibold text-rose-700"><%= item.priority %></span>
              <% end %>
            </div>

            <% if item.description.present? %>
              <p class="mt-4 text-sm leading-6 text-slate-600"><%= truncate(markdown_plain_text(item.description), length: 220) %></p>
            <% elsif item.review_notes.present? %>
              <p class="mt-4 text-sm leading-6 text-slate-600"><%= truncate(markdown_plain_text(item.review_notes), length: 220) %></p>
            <% end %>

            <dl class="mt-5 grid gap-3 rounded-2xl bg-slate-50 px-4 py-4 sm:grid-cols-2">
              <div>
                <dt class="text-[11px] font-black uppercase tracking-[0.22em] text-slate-400">Archived</dt>
                <dd class="mt-1 text-sm font-medium text-slate-700"><%= item.updated_at.strftime('%Y-%m-%d %H:%M UTC') %></dd>
              </div>
              <% if item.completed_at.present? %>
                <div>
                  <dt class="text-[11px] font-black uppercase tracking-[0.22em] text-slate-400">Completed</dt>
                  <dd class="mt-1 text-sm font-medium text-slate-700"><%= item.completed_at.strftime('%Y-%m-%d %H:%M UTC') %></dd>
                </div>
              <% end %>
              <% if completion_duration_label(item).present? %>
                <div>
                  <dt class="text-[11px] font-black uppercase tracking-[0.22em] text-slate-400">Cycle time</dt>
                  <dd class="mt-1 text-sm font-medium text-slate-700"><%= completion_duration_label(item) %></dd>
                </div>
              <% end %>
              <% if item.tag_list.any? %>
                <div class="sm:col-span-2">
                  <dt class="text-[11px] font-black uppercase tracking-[0.22em] text-slate-400">Tags</dt>
                  <dd class="mt-2 flex flex-wrap gap-2">
                    <% item.tag_list.each do |tag| %>
                      <span class="inline-flex rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-slate-600"><%= tag %></span>
                    <% end %>
                  </dd>
                </div>
              <% end %>
            </dl>
          </article>
        <% end %>
      </section>
    <% else %>
      <section class="mt-8 flex min-h-[18rem] items-center justify-center rounded-[2rem] border border-dashed border-slate-300 bg-white/75 p-8 text-center shadow-inner">
        <div class="max-w-lg">
          <div class="text-[11px] font-black uppercase tracking-[0.3em] text-amber-700">No matches</div>
          <h3 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-slate-950">No archived tasks match those filters</h3>
          <p class="mt-3 text-sm leading-6 text-slate-500">Try widening the date range, removing a worker or lane filter, or clearing everything to scan the full archive again.</p>
          <div class="mt-5">
            <%= link_to 'Reset filters', archive_path, class: 'inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-50' %>
          </div>
        </div>
      </section>
    <% end %>
  </main>
</div>
