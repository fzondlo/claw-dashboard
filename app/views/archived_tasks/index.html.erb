<div class="min-h-screen bg-slate-100 text-slate-900 lg:grid lg:grid-cols-[280px_minmax(0,1fr)]">
  <%= render "layouts/sidebar", updated_at: @updated_at %>

  <main class="px-4 py-6 sm:px-6 lg:px-10 lg:py-8">
    <div class="flex flex-col gap-3 border-b border-slate-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-medium text-sky-700">History</p>
        <h2 class="mt-1 text-3xl font-semibold tracking-[-0.04em] text-slate-950">Archived tasks</h2>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Tasks archived from the Kanban board.</p>
      </div>
      <div class="inline-flex w-fit items-center rounded-full bg-slate-900 px-4 py-2 text-sm font-medium text-white">
        <%= @archived_cards.count %> archived
      </div>
    </div>

    <section class="mt-8 grid gap-4 xl:grid-cols-2">
      <% if @archived_cards.any? %>
        <% @archived_cards.each do |item| %>
          <article class="rounded-[1.6rem] border border-slate-200/90 bg-white p-5 ring-1 ring-slate-100">
            <div class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.24em] text-sky-700">
              <span class="inline-block h-2 w-2 rounded-full bg-sky-500"></span>
              <span>Task #<%= item.display_task_id %></span>
            </div>
            <h4 class="mt-3 text-lg font-semibold leading-7 tracking-[-0.02em] text-slate-950"><%= item.title %></h4>
            <div class="mt-3 flex flex-wrap gap-2">
              <span class="inline-flex rounded-full border border-sky-100 bg-sky-50 px-2.5 py-1 text-xs font-semibold text-sky-700"><%= item.project_name %></span>
              <span class="inline-flex rounded-full border border-amber-100 bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700">Archived</span>
              <% if item.status.present? %>
                <span class="inline-flex rounded-full border border-white/70 px-2.5 py-1 text-xs font-semibold bg-slate-100 text-slate-600">Original status: <%= item.status.humanize %></span>
              <% end %>
            </div>
            <% if item.description.present? %>
              <p class="mt-4 text-sm leading-6 text-slate-600"><%= truncate(markdown_plain_text(item.description), length: 220) %></p>
            <% end %>
            <div class="mt-4 text-xs text-slate-400">Archived <%= item.updated_at.strftime('%Y-%m-%d %H:%M UTC') %></div>
          </article>
        <% end %>
      <% else %>
        <div class="flex min-h-[12rem] items-center justify-center rounded-[1.5rem] border border-dashed border-slate-300 bg-white/75 p-5 text-center text-sm leading-6 text-slate-500">No archived tasks yet.</div>
      <% end %>
    </section>
  </main>
</div>
