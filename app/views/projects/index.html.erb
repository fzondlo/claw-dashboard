<div class="min-h-screen bg-slate-100 text-slate-900 lg:grid lg:grid-cols-[280px_minmax(0,1fr)]">
  <%= render "layouts/sidebar", updated_at: @updated_at %>

  <main class="bg-gradient-to-br from-slate-100 via-slate-100 to-slate-200/70 px-4 py-6 sm:px-6 lg:px-10 lg:py-8">
    <div class="flex flex-col gap-3 border-b border-slate-200/80 pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-medium text-sky-700">Workspace overview</p>
        <h2 class="mt-1 text-3xl font-semibold tracking-[-0.04em] text-slate-950">Projects</h2>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Current apps and data projects that appear to be active in this workspace right now.</p>
      </div>
      <div class="inline-flex w-fit items-center rounded-full bg-slate-900 px-4 py-2 text-sm font-medium text-white">
        <%= @projects.count %> active projects
      </div>
    </div>

    <section class="mt-8 grid gap-4 lg:grid-cols-2 xl:grid-cols-3">
      <% @projects.each do |project| %>
        <article id="<%= project.slug %>" class="rounded-[1.75rem] border border-white/70 bg-white/70 p-6 ring-1 ring-slate-200/60 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/70">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-xl font-semibold tracking-[-0.03em] text-slate-950"><%= project.name %></h3>
            </div>
            <span class="inline-flex rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700"><%= project.status %></span>
          </div>
          <p class="mt-4 text-sm leading-6 text-slate-600"><%= project.description %></p>
          <% unless %w[dash-board openclaw].include?(project.slug) %>
            <div class="mt-5">
              <%= link_to project.link_label, project.url, class: "inline-flex items-center gap-2 rounded-full bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-800", target: "_blank", rel: "noopener noreferrer" %>
            </div>
          <% end %>
        </article>
      <% end %>
    </section>
  </main>
</div>
